# Скопируйте в .env.local и подставьте свои значения. Настоящие пароли в репозиторий не кладутся.
# Локально база поднимается командой npm run db:up — она берёт пароль отсюда же.
DATABASE_URL=postgres://naa:ПРИДУМАЙТЕ_ПАРОЛЬ@localhost:5432/naa

# Защита форм от ботов (Cloudflare Turnstile). Без них проверка в разработке идёт вопросом-загадкой.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Телеграм-бот: без токена уведомления просто не отправляются.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Проверки только на чтение: скрипты отказываются писать, когда переменная задана.
NAA_DB_READONLY=

# Ключ подписи для проверочного примера в форме отзыва (когда Turnstile не настроен)
# и для служебных операций. Любая длинная случайная строка, своя на каждом сервере:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERATIONS_SECRET=

# Демонабор (демо-машины, детали, отзывы, новости) виден на витрине только при NAA_SHOW_DEMO=1.
# На боевом сервере не задавать: демо будет скрыто, из базы ничего не удаляется.
NAA_SHOW_DEMO=

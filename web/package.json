{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "seed:demo": "node scripts/seed-demo.mjs",
    "verify:demo": "node scripts/verify-demo.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "qa": "node qa/responsive-check.mjs",
    "staff:create-owner": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-owner.ps1",
    "staff:create": "node scripts/create-staff.mjs",
    "staff:list": "node scripts/create-staff.mjs --list",
    "db:up": "docker start naa-postgres || docker run -d --name naa-postgres -e POSTGRES_USER=naa -e POSTGRES_PASSWORD=naa_local_dev -e POSTGRES_DB=naa -p 5432:5432 -v naa-pgdata:/var/lib/postgresql/data postgres:17-alpine",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import": "node scripts/db-import-sqlite.mjs",
    "operations:worker": "node scripts/operations-worker.mjs",
    "test:operations": "vitest run src/lib/operations.integration.test.ts",
    "telegram:setup": "node scripts/telegram-setup.mjs"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
